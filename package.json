{
  "name": "discord-bot",
  "version": "1.0.0",
  "license": "MIT",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "prettier": "prettier --write \"*.{js,ts}\" \"{**,.}/*.{js,ts}\"",
    "start": "TS_NODE_PROJECT=tsconfig.node.json node -r tsconfig-paths/register lib/index.js",
    "start:dev": "nodemon",
    "start:dev-w": "nodemon -L",
    "test": "exit 0"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.0.0",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.19.0",
    "config": "^4.4.2",
    "discord.js": "^12.5.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "quickchart-js": "^4.0.0",
    "ramda": "^0.32.0",
    "string-argv": "^0.3.2",
    "ts-node": "^9.1.1",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^14.0.1",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/config": "^4.4.0",
    "@types/express": "^5.0.6",
    "@types/ramda": "^0.32.0",
    "@types/uuid": "^11.0.0",
    "@types/yargs": "^16.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "please-use-yarn",
    "yarn": ">=1 <2"
  }
